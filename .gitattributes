# Normalize line endings: the dev host is Windows, CI runs Linux.
# Without this, every file churns between CRLF and LF across machines.
* text=eol=lf

# Explicit text types
*.md        text eol=lf diff=markdown
*.sql       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.jsx       text eol=lf
*.py        text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.svg       text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.editorconfig   text eol=lf
.env.example    text eol=lf

# Binary — never touch these
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.woff      binary
*.woff2     binary
*.pdf       binary

# Lockfiles: keep diffs collapsed in PR review
package-lock.json  -diff linguist-generated=true
pnpm-lock.yaml     -diff linguist-generated=true

# Generated types are not hand-edited; collapse in review
types/database.types.ts  linguist-generated=true

# Docs drive this repo today — don't let GitHub call it a "Shell" project
docs/**     linguist-documentation
workflow/** linguist-documentation
tasks/**    linguist-documentation
