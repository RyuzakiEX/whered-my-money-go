# Where'd My Money Go — environment contract
#
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# See docs/ops/environments.md for which value belongs in which environment,
# and docs/security/security-model.md for the secrets inventory.
#
# The values below are LOCAL-DEVELOPMENT defaults for `npx supabase start`.
# Keys are left blank on purpose: copy them from `npx supabase status -o env`.
# A blank key fails loudly; a wrong placeholder fails as a confusing 401.
#
# RULE: only variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# Anything secret must NOT carry that prefix. A NEXT_PUBLIC_ secret is a
# published secret.

# ---------------------------------------------------------------------------
# Supabase — public (safe to expose to the browser)
# ---------------------------------------------------------------------------

# Your Supabase project URL. [browser-safe]
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# The anon key. [browser-safe] Public by design — RLS is what protects data,
# not the secrecy of this key. See docs/architecture/rls-policies.md.
# Local: ANON_KEY from `npx supabase status -o env`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Supabase — SECRET (server-only, never NEXT_PUBLIC_)
# ---------------------------------------------------------------------------

# [server-only] Bypasses ALL row level security. Required for migrations and
# seeds only. Never imported into anything reachable from app/. Never a GitHub
# Actions secret. Production value lives in Vercel's production environment only.
# Local: SERVICE_ROLE_KEY from `npx supabase status -o env`.
SUPABASE_SERVICE_ROLE_KEY=

# [server-only] Direct Postgres connection string, used by the Supabase CLI,
# integration tests, and pgTAP tests.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# [server-only] Project ref from the Supabase dashboard URL. Used only by
# `supabase link` against a hosted project — leave blank for local work.
SUPABASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# [browser-safe] Canonical origin, used for auth redirects and password-reset
# links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
