# Where'd My Money Go — environment contract
#
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# See docs/ops/environments.md for which value belongs in which environment,
# and docs/security/security-model.md for the secrets inventory.
#
# RULE: only variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# Anything secret must NOT carry that prefix. A NEXT_PUBLIC_ secret is a
# published secret.

# ---------------------------------------------------------------------------
# Supabase — public (safe to expose to the browser)
# ---------------------------------------------------------------------------

# Your Supabase project URL.
# Local default (from `supabase start`): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# The anon/publishable key. Public by design — RLS is what protects data,
# not the secrecy of this key. See docs/architecture/rls-policies.md.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Supabase — SECRET (server-only, never NEXT_PUBLIC_)
# ---------------------------------------------------------------------------

# Bypasses ALL row level security. Required for migrations and seeds only.
# Never imported into anything reachable from app/. Never a GitHub Actions
# secret. Production value lives in Vercel's production environment only.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used by the Supabase CLI and pgTAP tests.
# Local default: postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=

# Project ref from the Supabase dashboard URL. Used by `supabase link`.
SUPABASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Canonical origin, used for auth redirects and password-reset links.
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
