# EditorConfig: https://editorconfig.org
# Applies before Prettier exists, and to files Prettier never touches.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = off

[*.md]
# Markdown uses trailing double-space for hard line breaks
trim_trailing_whitespace = false

[*.{sql,py}]
indent_size = 4

[Makefile]
indent_style = tab

[{package.json,package-lock.json,*.yml,*.yaml}]
indent_size = 2
